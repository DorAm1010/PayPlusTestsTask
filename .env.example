# Copy this file to .env and fill in the real values before running tests.

# Staging (dev/sandbox) REST API base URL
PAYPLUS_API_BASE_URL=https://restapidev.payplus.co.il/api/v1.0

# Credentials - fill these in with the values provided for this test.
# Do NOT commit the real values: copy this file to .env (which is gitignored)
# and put them there instead.
PAYPLUS_API_KEY=your-api-key
PAYPLUS_SECRET_KEY=your-secret-key
PAYPLUS_PAYMENT_PAGE_UID=your-payment-page-uid

# true/false - run Chrome headless (set to false to watch the UI/E2E tests locally)
HEADLESS=true

# Seconds Selenium waits for elements on the payment page
UI_TIMEOUT=20
